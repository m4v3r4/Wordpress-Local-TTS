msgid "Installed"
msgstr "Installé"

#: includes/class-ltts-admin.php:398
msgid "served"
msgstr "proposée"

#: includes/class-ltts-admin.php:401
msgid "Update available"
msgstr "Mise à jour disponible"

#: includes/class-ltts-admin.php:403
msgid "Not installed"
msgstr "Non installé"

#: includes/class-ltts-admin.php:405
msgid "Coming later"
msgstr "Plus tard"

#: includes/class-ltts-admin.php:411
msgid "%1$s is third-party software distributed under its own licence: %2$s. Your site will send this voice to readers’ browsers, so make sure you may use and redistribute it. Continue?"
msgstr "%1$s est un logiciel tiers distribué sous sa propre licence : %2$s. Votre site enverra cette voix aux navigateurs des lecteurs ; assurez-vous de pouvoir l’utiliser et la redistribuer. Continuer ?"

#: includes/class-ltts-admin.php:412
msgid "Update"
msgstr "Mettre à jour"

#: includes/class-ltts-admin.php:412
msgid "Install"
msgstr "Installer"

#: includes/class-ltts-admin.php:414
msgid "If you uploaded the files by FTP"
msgstr "Si vous avez envoyé les fichiers par FTP"

