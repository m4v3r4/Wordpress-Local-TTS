msgstr "Rechercher par langue, pays ou nom"

#: includes/class-ltts-admin.php:504 includes/class-ltts-admin.php:519
msgid "Add to the list"
msgstr "Ajouter à la liste"

#: includes/class-ltts-admin.php:508
msgid "From addresses (any Piper-compatible voice)"
msgstr "Depuis des adresses (toute voix compatible Piper)"

#: includes/class-ltts-admin.php:510
msgid "Name"
msgstr "Nom"

#: includes/class-ltts-admin.php:511
msgid "Language code"
msgstr "Code de langue"

#: includes/class-ltts-admin.php:512
msgid "Model (.onnx) address"
msgstr "Adresse du modèle (.onnx)"

#: includes/class-ltts-admin.php:513
msgid "Configuration (.onnx.json) address"
msgstr "Adresse de la configuration (.onnx.json)"

#: includes/class-ltts-admin.php:514
msgid "SHA-256 of the model (recommended)"
msgstr "SHA-256 du modèle (recommandé)"

#: includes/class-ltts-admin.php:515
msgid "Licence"
msgstr "Licence"

#: includes/class-ltts-admin.php:516
msgid "Credit shown to readers"
msgstr "Crédit affiché aux lecteurs"

#: includes/class-ltts-admin.php:517
msgid "Homepage or source"
msgstr "Site ou source"

#: includes/class-ltts-admin.php:533
msgid "Default speed"
msgstr "Vitesse par défaut"

#: includes/class-ltts-admin.php:536
msgid "1 is normal speed; between 0.7 and 1.5. Readers can change it in the player."
msgstr "1 correspond à la vitesse normale ; entre 0,7 et 1,5. Les lecteurs peuvent la modifier dans le lecteur."

#: includes/class-ltts-admin.php:542
msgid "Highlight the paragraph being read"
msgstr "Surligner le paragraphe en cours de lecture"

#: includes/class-ltts-admin.php:543
msgid "Show the download size before the first listen"
msgstr "Afficher la taille du téléchargement avant la première écoute"

#: includes/class-ltts-admin.php:544
msgid "Show the voice credit under the player (some voice licences require attribution)"
msgstr "Afficher le crédit de la voix sous le lecteur (certaines licences exigent une attribution)"

#: includes/class-ltts-admin.php:548
msgid "Parts not to read"
msgstr "Parties à ne pas lire"

#: includes/class-ltts-admin.php:551
msgid "One CSS selector per line. Code blocks, hidden elements, footnotes and share boxes are already skipped. To skip a single block, give it the ltts-skip class."
msgstr "Un sélecteur CSS par ligne. Les blocs de code, éléments masqués, notes de bas de page et boutons de partage sont déjà ignorés. Pour ignorer un seul bloc, donnez-lui la classe ltts-skip."

#: includes/class-ltts-admin.php:569
msgid "Plugin version"
msgstr "Version de l’extension"

#: includes/class-ltts-admin.php:570
msgid "Download folder"
msgstr "Dossier de téléchargement"

#: includes/class-ltts-admin.php:571
msgid "installed"
msgstr "installé"

#: includes/class-ltts-admin.php:571
msgid "not installed"
msgstr "non installé"

#: includes/class-ltts-admin.php:572
msgid "Served languages"
msgstr "Langues proposées"

#: includes/class-ltts-admin.php:572
msgid "none"
msgstr "aucune"

#: includes/class-ltts-admin.php:573
msgid "yes"
msgstr "oui"

#: includes/class-ltts-admin.php:573
msgid "no (the browser cache and integrity checks need HTTPS)"
msgstr "non (le cache du navigateur et les vérifications d’intégrité nécessitent HTTPS)"

