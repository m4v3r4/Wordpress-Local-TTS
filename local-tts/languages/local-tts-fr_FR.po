msgstr "Exécute les modèles de voix dans le navigateur. Requis par toutes les voix."

#: includes/class-ltts-catalog.php:116
msgid "Converts text to phonemes for Piper voices, in the browser. Installed automatically with the first Piper voice."
msgstr "Convertit le texte en phonèmes pour les voix Piper, dans le navigateur. Installé automatiquement avec la première voix Piper."

#: includes/class-ltts-catalog.php:137
msgid "EMA Lightning (Turkish)"
msgstr "EMA Lightning (turc)"

#: includes/class-ltts-catalog.php:138
