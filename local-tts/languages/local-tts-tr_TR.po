#: includes/class-ltts-admin.php:73
msgid "Settings"
msgstr "Ayarlar"

#: includes/class-ltts-admin.php:88
msgid "Display"
msgstr "Görünüm"

#: includes/class-ltts-admin.php:89
msgid "Voices"
msgstr "Ses modelleri"

#: includes/class-ltts-admin.php:90
msgid "Reading"
msgstr "Okuma"

#: includes/class-ltts-admin.php:91 includes/class-ltts-admin.php:362
msgid "Status"
msgstr "Durum"

#: includes/class-ltts-admin.php:112
msgid "Downloading…"
msgstr "İndiriliyor…"

#: includes/class-ltts-admin.php:114
msgid "{loaded} / {total} MB"
msgstr "{loaded} / {total} MB"

