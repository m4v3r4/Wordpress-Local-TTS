#: includes/class-ltts-i18n.php:55
msgid "French"
msgstr "Fransızca"

#: includes/class-ltts-i18n.php:56
msgid "Spanish"
msgstr "İspanyolca"

#: includes/class-ltts-installer.php:58
msgid "No installation is running."
msgstr "Süren bir yükleme yok."

#: includes/class-ltts-installer.php:72
msgid "Unknown component."
msgstr "Bilinmeyen bileşen."

#: includes/class-ltts-installer.php:139 includes/class-ltts-installer.php:501
msgid "This component cannot be installed by this version."
msgstr "Bu bileşen bu sürümde yüklenemez."

#: includes/class-ltts-installer.php:143
msgid "Another installation is running."
msgstr "Başka bir yükleme sürüyor."

