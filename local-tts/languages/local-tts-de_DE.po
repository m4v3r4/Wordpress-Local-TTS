msgstr "unbegrenzt"

#: includes/class-ltts-admin.php:576
msgid "Site language"
msgstr "Sprache der Website"

#: includes/class-ltts-admin.php:589
msgid "Server check"
msgstr "Serverprüfung"

#: includes/class-ltts-admin.php:590
msgid "Tests whether the server can download files and serves .wasm and .mjs files with the right type."
msgstr "Prüft, ob der Server Dateien herunterladen kann und .wasm- und .mjs-Dateien mit dem richtigen Typ ausliefert."

#: includes/class-ltts-admin.php:591
msgid "Run check"
msgstr "Prüfung starten"

#: includes/class-ltts-admin.php:593
msgid "Outgoing connection (for downloads)"
msgstr "Ausgehende Verbindung (für Downloads)"

#: includes/class-ltts-admin.php:598
msgid "Check in the browser"
msgstr "Im Browser prüfen"

#: includes/class-ltts-admin.php:600
msgid "If the site has a Content Security Policy, it must allow: script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self'."
msgstr "Wenn die Website eine Content Security Policy hat, muss sie Folgendes erlauben: script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self'."

#: includes/class-ltts-admin.php:601
msgid "Caching and minification plugins must not combine assets/js/player.js or tts-worker.js."
msgstr "Caching- und Minifizierungs-Plugins dürfen assets/js/player.js und tts-worker.js nicht zusammenfassen."

#: includes/class-ltts-admin.php:602
msgid "A second post must not download the voice again (Developer tools → Application → Cache Storage)."
msgstr "Bei einem zweiten Beitrag darf die Stimme nicht erneut heruntergeladen werden (Entwicklertools → Application → Cache Storage)."

#: includes/class-ltts-admin.php:617
msgid "Local TTS: settings, post options and downloaded voices were moved over from the previous plugin (Kulak Ver / asosyoloji-dinle), which has been deactivated. You can delete it from the Plugins page."
msgstr "Local TTS: Einstellungen, Beitragsoptionen und heruntergeladene Stimmen wurden aus dem vorherigen Plugin (Kulak Ver / asosyoloji-dinle) übernommen; es wurde deaktiviert. Sie können es auf der Plugin-Seite löschen."

#: includes/class-ltts-admin.php:629
msgid "Local TTS: no voice is installed yet, so visitors don’t see the “Listen” button."
msgstr "Local TTS: Es ist noch keine Stimme installiert, daher sehen Besucher die „Anhören“-Schaltfläche nicht."

