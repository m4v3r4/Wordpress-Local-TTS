#: includes/class-ltts-catalog.php:95
msgid "Runs the voice models in the browser. Required by every voice."
msgstr "Führt die Stimmmodelle im Browser aus. Wird von jeder Stimme benötigt."

#: includes/class-ltts-catalog.php:116
msgid "Converts text to phonemes for Piper voices, in the browser. Installed automatically with the first Piper voice."
msgstr "Wandelt Text für Piper-Stimmen im Browser in Phoneme um. Wird mit der ersten Piper-Stimme automatisch installiert."

#: includes/class-ltts-catalog.php:137
