msgstr "Voz femenina. Entrenada desde cero con el conjunto de datos LJ Speech, de dominio público."

#: includes/class-ltts-catalog.php:155
msgid "Public domain dataset"
msgstr "Conjunto de datos de dominio público"

#: includes/class-ltts-catalog.php:160
msgid "Piper Thorsten (German)"
msgstr "Piper Thorsten (alemán)"

#: includes/class-ltts-catalog.php:161
