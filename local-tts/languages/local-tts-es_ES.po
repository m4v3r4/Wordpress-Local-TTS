msgstr "Componente desconocido."

#: includes/class-ltts-installer.php:139 includes/class-ltts-installer.php:501
msgid "This component cannot be installed by this version."
msgstr "Este componente no se puede instalar con esta versión."

#: includes/class-ltts-installer.php:143
msgid "Another installation is running."
msgstr "Ya hay otra instalación en curso."

#: includes/class-ltts-installer.php:146
