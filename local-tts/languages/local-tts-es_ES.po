msgstr "No se puede escribir en la carpeta de descargas (wp-content/uploads)."

#: includes/class-ltts-installer.php:211
msgid "Could not read file details from Hugging Face: %s"
msgstr "No se pudieron leer los datos del archivo en Hugging Face: %s"

#: includes/class-ltts-installer.php:226
msgid "File not found on Hugging Face: %s"
msgstr "Archivo no encontrado en Hugging Face: %s"

#: includes/class-ltts-installer.php:278
msgid "The component is not in the catalog."
msgstr "El componente no está en el catálogo."

#: includes/class-ltts-installer.php:338
msgid "%s could not be downloaded from any source."
msgstr "No se pudo descargar %s desde ninguna fuente."

#: includes/class-ltts-installer.php:403
msgid "Could not download %1$s. Details: %2$s"
msgstr "No se pudo descargar %1$s. Detalles: %2$s"

#: includes/class-ltts-installer.php:445
msgid "Could not download %1$s: %2$s"
msgstr "No se pudo descargar %1$s: %2$s"

