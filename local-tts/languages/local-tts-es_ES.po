msgstr "Voz masculina. Conjunto de datos Thorsten-Voice (CC0)."

#: includes/class-ltts-catalog.php:162 includes/class-ltts-catalog.php:176
msgid "CC0 dataset"
msgstr "conjunto de datos CC0"

